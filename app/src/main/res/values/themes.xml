<resources>
    <style name="Theme.HanTVMobile" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/owntv_window_bg</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="Theme.HanTVMobile.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#070B10</item>
        <item name="postSplashScreenTheme">@style/Theme.HanTVMobile</item>
        <item name="windowSplashScreenAnimatedIcon">@android:color/transparent</item>
    </style>
    <style name="Theme.HanTVMobile.Starting.Petrol" parent="Theme.HanTVMobile.Starting">
        <item name="windowSplashScreenAnimatedIcon">@android:color/transparent</item>
    </style>
    <style name="Theme.HanTVMobile.Starting.Sunflower" parent="Theme.HanTVMobile.Starting">
        <item name="windowSplashScreenAnimatedIcon">@android:color/transparent</item>
    </style>
    <style name="Theme.HanTVMobile.Starting.Cobalt" parent="Theme.HanTVMobile.Starting">
        <item name="windowSplashScreenAnimatedIcon">@android:color/transparent</item>
    </style>
    <style name="Theme.HanTVMobile.Starting.Tomato" parent="Theme.HanTVMobile.Starting">
        <item name="windowSplashScreenAnimatedIcon">@android:color/transparent</item>
    </style>
    <style name="Theme.HanTVMobile.Starting.Board" parent="Theme.HanTVMobile.Starting">
        <item name="windowSplashScreenAnimatedIcon">@android:color/transparent</item>
    </style>
    <style name="Theme.HanTVMobile.Starting.Eggshell" parent="Theme.HanTVMobile.Starting">
        <item name="windowSplashScreenAnimatedIcon">@android:color/transparent</item>
    </style>
    <style name="Theme.HanTVMobile.Starting.Olive" parent="Theme.HanTVMobile.Starting">
        <item name="windowSplashScreenAnimatedIcon">@android:color/transparent</item>
    </style>
    <style name="Theme.HanTVMobile.Starting.OliveCream" parent="Theme.HanTVMobile.Starting">
        <item name="windowSplashScreenAnimatedIcon">@android:color/transparent</item>
    </style>

    <style name="Theme.HanTVMobile.CastButton" parent="Theme.AppCompat.NoActionBar">
        <item name="mediaRouteButtonStyle">@style/Widget.HanTVMobile.MediaRouteButton.Light</item>
    </style>

    <style name="Theme.HanTVMobile.CastButton.Dark">
        <item name="mediaRouteButtonStyle">@style/Widget.HanTVMobile.MediaRouteButton.Dark</item>
    </style>

    <style name="Widget.HanTVMobile.MediaRouteButton.Light" parent="Widget.MediaRouter.MediaRouteButton">
        <item name="mediaRouteButtonTint">@android:color/white</item>
    </style>

    <style name="Widget.HanTVMobile.MediaRouteButton.Dark" parent="Widget.MediaRouter.MediaRouteButton">
        <item name="mediaRouteButtonTint">#DE000000</item>
    </style>

    <!-- Legacy style aliases -->
    <style name="Theme.OwnTVMobile" parent="Theme.HanTVMobile" />
    <style name="Theme.OwnTVMobile.Starting" parent="Theme.HanTVMobile.Starting" />
    <style name="Theme.OwnTVMobile.Starting.Petrol" parent="Theme.HanTVMobile.Starting.Petrol" />
    <style name="Theme.OwnTVMobile.Starting.Sunflower" parent="Theme.HanTVMobile.Starting.Sunflower" />
    <style name="Theme.OwnTVMobile.Starting.Cobalt" parent="Theme.HanTVMobile.Starting.Cobalt" />
    <style name="Theme.OwnTVMobile.Starting.Tomato" parent="Theme.HanTVMobile.Starting.Tomato" />
    <style name="Theme.OwnTVMobile.Starting.Board" parent="Theme.HanTVMobile.Starting.Board" />
    <style name="Theme.OwnTVMobile.Starting.Eggshell" parent="Theme.HanTVMobile.Starting.Eggshell" />
    <style name="Theme.OwnTVMobile.Starting.Olive" parent="Theme.HanTVMobile.Starting.Olive" />
    <style name="Theme.OwnTVMobile.Starting.OliveCream" parent="Theme.HanTVMobile.Starting.OliveCream" />
    <style name="Theme.OwnTVMobile.CastButton" parent="Theme.HanTVMobile.CastButton" />
    <style name="Theme.OwnTVMobile.CastButton.Dark" parent="Theme.HanTVMobile.CastButton.Dark" />
</resources>
