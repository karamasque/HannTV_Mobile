<resources>
    <style name="Theme.HanTVMobile" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/owntv_window_bg</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="Theme.OwnTVMobile.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/owntv_window_bg</item>
        <item name="postSplashScreenTheme">@style/Theme.OwnTVMobile</item>
    </style>
    <style name="Theme.OwnTVMobile.Starting.Petrol">
        <item name="windowSplashScreenAnimatedIcon">@drawable/owntv_splash_static_petrol</item>
    </style>
    <style name="Theme.OwnTVMobile.Starting.Sunflower">
        <item name="windowSplashScreenAnimatedIcon">@drawable/owntv_splash_static_sunflower</item>
    </style>
    <style name="Theme.OwnTVMobile.Starting.Cobalt">
        <item name="windowSplashScreenAnimatedIcon">@drawable/owntv_splash_static_cobalt</item>
    </style>
    <style name="Theme.OwnTVMobile.Starting.Tomato">
        <item name="windowSplashScreenAnimatedIcon">@drawable/owntv_splash_static_tomato</item>
    </style>
    <style name="Theme.OwnTVMobile.Starting.Board">
        <item name="windowSplashScreenAnimatedIcon">@drawable/owntv_splash_static_board</item>
    </style>
    <style name="Theme.OwnTVMobile.Starting.Eggshell">
        <item name="windowSplashScreenAnimatedIcon">@drawable/owntv_splash_static_eggshell</item>
    </style>
    <style name="Theme.OwnTVMobile.Starting.Olive">
        <item name="windowSplashScreenAnimatedIcon">@drawable/owntv_splash_static_olive</item>
    </style>
    <style name="Theme.OwnTVMobile.Starting.OliveCream">
        <item name="windowSplashScreenAnimatedIcon">@drawable/owntv_splash_static_olive_cream</item>
    </style>

    <style name="Theme.HanTVMobile.CastButton" parent="Theme.AppCompat.NoActionBar">
        <item name="mediaRouteButtonStyle">@style/Widget.HanTVMobile.MediaRouteButton.Light</item>
    </style>

    <style name="Theme.HanTVMobile.CastButton.Dark">
        <item name="mediaRouteButtonStyle">@style/Widget.HanTVMobile.MediaRouteButton.Dark</item>
    </style>

    <style name="Widget.HanTVMobile.MediaRouteButton.Light" parent="Widget.MediaRouter.MediaRouteButton">
        <item name="mediaRouteButtonTint">@android:color/white</item>
    </style>

    <style name="Widget.HanTVMobile.MediaRouteButton.Dark" parent="Widget.MediaRouter.MediaRouteButton">
        <item name="mediaRouteButtonTint">#DE000000</item>
    </style>

    <!-- Legacy style aliases -->
    <style name="Theme.OwnTVMobile" parent="Theme.HanTVMobile" />
    <style name="Theme.OwnTVMobile.CastButton" parent="Theme.HanTVMobile.CastButton" />
    <style name="Theme.OwnTVMobile.CastButton.Dark" parent="Theme.HanTVMobile.CastButton.Dark" />
</resources>
